{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": true,
  "vulnerabilityAlerts": {
    "automerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "matchFileNames": [
        ".python-version"
      ],
      "enabled": false
    }
  ]
}
