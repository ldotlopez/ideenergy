{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": true,
  "vulnerabilityAlerts": {
    "automerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor",
        "major"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true
    },
    {
      "matchFileNames": [
        ".python-version"
      ],
      "enabled": false
    }
  ]
}
